<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="109">
    <author>The CMM Farmer</author>
    <version>0.9.4.3</version>
    <title>
        <en>DroneCam (Beta)</en>
    </title>
    <description>
        <en>
            <![CDATA[Automatically switches to a smooth, drone-style camera while your vehicle is working a field, and returns to the normal vehicle camera when work stops.

Three camera modes: Chase, Top-down and Orbit. Height is clamped above the terrain and raised automatically to clear trees and buildings. Purely client-side; all settings are stored locally.]]>
        </en>
    </description>

    <multiplayer supported="true"/>
    <iconFilename>icon_DroneCam.dds</iconFilename>

    <l10n filenamePrefix="l10n/l10n"/>

    <extraSourceFiles>
        <sourceFile filename="scripts/DroneCamSettings.lua"/>
        <sourceFile filename="scripts/DroneCamWorkDetect.lua"/>
        <sourceFile filename="scripts/DroneCamRig.lua"/>
        <sourceFile filename="scripts/DroneCamField.lua"/>
        <sourceFile filename="scripts/DroneCamSpot.lua"/>
        <sourceFile filename="scripts/DroneCamKit.lua"/>
        <sourceFile filename="scripts/DroneCamDirector.lua"/>
        <sourceFile filename="scripts/DroneCamCreator.lua"/>
        <sourceFile filename="scripts/DroneCamCamera.lua"/>
        <sourceFile filename="scripts/DroneCam.lua"/>
    </extraSourceFiles>

    <actions>
        <action name="DRONECAM_TOGGLE" category="VEHICLE" ignoreComboMask="false"/>
        <action name="DRONECAM_MODE" category="VEHICLE" ignoreComboMask="false"/>
        <action name="DRONECAM_FORCE" category="VEHICLE" ignoreComboMask="false"/>
        <action name="DRONECAM_HUD" category="VEHICLE" ignoreComboMask="false"/>
        <action name="DRONECAM_DRIVE_OVER" category="VEHICLE" ignoreComboMask="false"/>
        <action name="DRONECAM_DEBUG" category="VEHICLE" ignoreComboMask="false"/>
    </actions>

    <inputBinding>
        <actionBinding action="DRONECAM_TOGGLE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_d"/>
        </actionBinding>
        <actionBinding action="DRONECAM_MODE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_c"/>
        </actionBinding>
        <actionBinding action="DRONECAM_FORCE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_f"/>
        </actionBinding>
        <actionBinding action="DRONECAM_HUD">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_h"/>
        </actionBinding>
        <actionBinding action="DRONECAM_DRIVE_OVER">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_g"/>
        </actionBinding>
        <actionBinding action="DRONECAM_DEBUG">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_lshift KEY_d"/>
        </actionBinding>
    </inputBinding>
</modDesc>
